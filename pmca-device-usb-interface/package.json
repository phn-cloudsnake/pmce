{
  "name": "pmce-usb-interface",
  "version": "0.1.0",
  "description": "TypeScript port of the Sony PMCA reverse-engineering tool's MTP/SCSI command layer targeting WebUSB",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.14",
    "@vitest/coverage-v8": "^2.0.5",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
